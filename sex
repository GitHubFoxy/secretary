#!/bin/zsh
set -euo pipefail
umask 077

ROOT="${0:A:h}"
STATE="$HOME/.local/share/secretary"
BIN="$HOME/.local/bin"
ENV_FILE="$STATE/environment"
PID_FILE="$STATE/server.pid"
MODE_FILE="$STATE/server.mode"
LOG_FILE="$STATE/secretaryd.log"
CAPABILITY_FILE="$STATE/secretary-runtime-credential"
NODE_STATE="$STATE/node"
NODE_CONFIG="$NODE_STATE/config.json"
NODE_DATA="$NODE_STATE/data"
NODE_BIN="$BIN/secretary-node"
MIGRATE_BIN="$BIN/secretary-migrate"
NODE_PID_FILE="$NODE_STATE/node.pid"
NODE_LOG_FILE="$NODE_STATE/secretary-node.log"
NODE_PLIST="$HOME/Library/LaunchAgents/dev.secretary.sex-node.plist"
PLIST="$HOME/Library/LaunchAgents/dev.secretary.sex.plist"
URL="http://127.0.0.1:8081"

usage() {
  cat <<'EOF'
Usage: sex <command> [options]

Commands:
  setup             Build Secretary and install/check the configured harness
  start [--debug]   Start or reuse the server and open the User UI
  stop              Stop the local Secretary server
  restart [--debug] Restart the server and open the User UI
  status            Show server status and mode
  logs              Follow the server log
  doctor            Check paths, binaries, config, and harness readiness
  install-service [--debug]
                    Install a launchd service that survives terminal exit
  uninstall-service Remove the launchd service
  node setup       Configure a private outbound Execution Node
  node start|stop|status|logs|doctor
                    Manage the local Execution Node process
  node opencode login
                    Explicitly log in to the selected Node OpenCode store
  node drain|revoke Safely drain or revoke the configured Node
                    revoke waits for remote active work; use --force only to override
  node install-service|uninstall-service
                    Manage the Node launchd service
  opencode login   Explicitly log in to the selected shared Secretary/Node OpenCode store
  opencode select-shared-store
                    Explicitly select one private store for Secretary and the co-located Node
EOF
}

load_environment() {
  [[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
}

write_bootstrap_environment() {
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  if [[ ! -f "$ENV_FILE" ]]; then
    umask 077
    printf "export SECRETARY_BOOTSTRAP_TOKEN='%s'\n" "$(openssl rand -hex 32)" > "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
}

configured_harness() {
  local config="$STATE/config.toml"
  if [[ -f "$config" ]]; then
    local harness
    harness="$(awk -F'=' '/^[[:space:]]*harness[[:space:]]*=/{gsub(/[ "\r]/, "", $2); print $2; exit}' "$config")"
    [[ -n "$harness" ]] && { print "$harness"; return 0; }
  fi
  print "opencode"
}

path_command() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for candidate in "$BIN/$name" "$HOME/.local/share/mise/shims/$name" "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
    [[ -x "$candidate" ]] && { print "$candidate"; return 0; }
  done
  return 1
}

harness_command() {
  case "$(configured_harness)" in
    codex)
      [[ -n "${SECRETARY_ACP_COMMAND:-}" ]] && { print "$SECRETARY_ACP_COMMAND"; return 0; }
      path_command codex-acp ;;
    fx)
      [[ -n "${SECRETARY_FX_COMMAND:-}" ]] && { print "$SECRETARY_FX_COMMAND"; return 0; }
      path_command fx ;;
    opencode)
      [[ -n "${SECRETARY_OPENCODE_COMMAND:-}" ]] && { print "$SECRETARY_OPENCODE_COMMAND"; return 0; }
      path_command opencode ;;
    *) return 1 ;;
  esac
}

build() {
  mkdir -p "$BIN"
  cd "$ROOT"
  mise exec -- go build -o "$BIN/secretaryd" ./cmd/secretaryd
  mise exec -- go build -o "$BIN/secretaryctl" ./cmd/secretaryctl
  mise exec -- go build -o "$BIN/secretary-mcp" ./cmd/secretary-mcp
  mise exec -- go build -o "$MIGRATE_BIN" ./cmd/secretary-migrate
  mise exec -- go build -o "$NODE_BIN" ./cmd/secretary-node
}

ensure_config() {
  [[ -f "$STATE/config.toml" ]] && return 0
  mkdir -p "$STATE/profiles"
  cp "$ROOT/internal/config/defaults/config.toml" "$STATE/config.toml"
  cp "$ROOT/internal/config/defaults/secretary.md" "$STATE/profiles/secretary.md"
  cp "$ROOT/internal/config/defaults/worker.md" "$STATE/profiles/worker.md"
  cp "$ROOT/internal/config/defaults/child-worker.md" "$STATE/profiles/child-worker.md"
  chmod 700 "$STATE/profiles"
  chmod 600 "$STATE/config.toml" "$STATE/profiles"/*.md
}

node_config_value() {
  local key="$1"
  [[ -f "$NODE_CONFIG" ]] || return 1
  awk -F'"' -v wanted="$key" '$2 == wanted { print $4; exit }' "$NODE_CONFIG"
}

ensure_private_opencode_store() {
  local data_home="$1" root="${1:h}"
  [[ ! -L "$root" && ! -L "$data_home" && ! -L "$data_home/opencode" ]] || { print -u2 "OpenCode native store path must not contain symlinks"; return 1; }
  mkdir -p "$data_home/opencode"
  chmod 700 "$root" "$data_home" "$data_home/opencode"
}

validate_store_record_pair() {
  local mode="$1" data_home="$2"
  [[ "$mode" == "isolated" || "$mode" == "shared" || "$mode" == "legacy" ]] || return 1
  [[ "$data_home" == /* && "$data_home" != *$'\n'* && "$data_home" != *$'\r'* && "$data_home" != *$'\x1f'* ]] || return 1
}

parse_store_cli_record() {
  local record="$1" separator=$'\x1f' standalone include_opencode
  local -a fields
  [[ "$record" != *$'\n'* && "$record" != *$'\r'* ]] || return 1
  IFS="$separator" read -rA fields <<< "$record"
  case "$fields[1]" in
    secretary)
      [[ ${#fields} -eq 7 ]] || return 1
      validate_store_record_pair "$fields[2]" "$fields[3]" || return 1
      validate_store_record_pair "$fields[4]" "$fields[5]" || return 1
      [[ "$fields[6]" == /* && "$fields[6]" != *$'\n'* && "$fields[6]" != *$'\r'* && "$fields[6]" != *$'\x1f'* ]] || return 1
      standalone="$fields[7]"
      [[ "$standalone" == "true" || "$standalone" == "false" ]] || return 1
      typeset -g SELECTED_SECRETARY_MODE="$fields[2]" SELECTED_SECRETARY_DATA_HOME="$fields[3]"
      typeset -g SELECTED_LOCAL_NODE_MODE="$fields[4]" SELECTED_LOCAL_NODE_DATA_HOME="$fields[5]"
      typeset -g SELECTED_LOCAL_NODE_DATA_DIR="$fields[6]" SELECTED_LOCAL_NODE_STANDALONE="$standalone"
      ;;
    node)
      [[ ${#fields} -eq 6 ]] || return 1
      validate_store_record_pair "$fields[2]" "$fields[3]" || return 1
      [[ "$fields[4]" == /* && "$fields[4]" != *$'\n'* && "$fields[4]" != *$'\r'* && "$fields[4]" != *$'\x1f'* ]] || return 1
      standalone="$fields[5]"
      include_opencode="$fields[6]"
      [[ ( "$standalone" == "true" || "$standalone" == "false" ) && ( "$include_opencode" == "true" || "$include_opencode" == "false" ) ]] || return 1
      typeset -g SELECTED_NODE_MODE="$fields[2]" SELECTED_NODE_DATA_HOME="$fields[3]" SELECTED_NODE_DATA_DIR="$fields[4]"
      typeset -g SELECTED_NODE_STANDALONE="$standalone" SELECTED_NODE_INCLUDE_OPENCODE="$include_opencode"
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_secretary_opencode_stores() {
  typeset -g SELECTED_SECRETARY_MODE="" SELECTED_SECRETARY_DATA_HOME="" SELECTED_LOCAL_NODE_MODE="" SELECTED_LOCAL_NODE_DATA_HOME="" SELECTED_LOCAL_NODE_DATA_DIR="" SELECTED_LOCAL_NODE_STANDALONE=""
  [[ -x "$BIN/secretaryd" ]] || { print -u2 "secretaryd is unavailable; run sex setup before OpenCode operations"; return 1; }
  local record
  if ! record="$("$BIN/secretaryd" --data-dir "$STATE" --select-opencode-stores --print-opencode-stores)" || ! parse_store_cli_record "$record" || [[ "$record" != secretary$'\x1f'* ]]; then
    print -u2 "Secretary/Node OpenCode store selection is invalid; native CLI was not launched."
    return 1
  fi
}

resolve_node_opencode_store() {
  typeset -g SELECTED_NODE_MODE="" SELECTED_NODE_DATA_HOME="" SELECTED_NODE_DATA_DIR="" SELECTED_NODE_STANDALONE="" SELECTED_NODE_INCLUDE_OPENCODE=""
  [[ -x "$NODE_BIN" && -f "$NODE_CONFIG" ]] || { print -u2 "Node deployment is unavailable; run sex node setup before OpenCode operations"; return 1; }
  local record
  if ! record="$("$NODE_BIN" --config "$NODE_CONFIG" --select-opencode-store --print-opencode-store 2>/dev/null)" || ! parse_store_cli_record "$record" || [[ "$record" != node$'\x1f'* ]]; then
    print -u2 "Node OpenCode store selection is invalid; native CLI was not launched."
    return 1
  fi
}

validate_node_opencode_selection() {
  resolve_node_opencode_store || return 1
  if [[ "$SELECTED_NODE_STANDALONE" != "true" && ( -f "$STATE/config.toml" || -f "$STATE/secretary.db" ) ]]; then
    resolve_secretary_opencode_stores || { print -u2 "Co-located Secretary/Node OpenCode store selection is invalid; native CLI was not launched."; return 1; }
    if [[ "$SELECTED_NODE_DATA_DIR" != "$SELECTED_LOCAL_NODE_DATA_DIR" || "$SELECTED_NODE_STANDALONE" != "$SELECTED_LOCAL_NODE_STANDALONE" || "$SELECTED_NODE_MODE" != "$SELECTED_SECRETARY_MODE" || "$SELECTED_NODE_DATA_HOME" != "$SELECTED_SECRETARY_DATA_HOME" || "$SELECTED_NODE_MODE" != "$SELECTED_LOCAL_NODE_MODE" || "$SELECTED_NODE_DATA_HOME" != "$SELECTED_LOCAL_NODE_DATA_HOME" ]]; then
      print -u2 "Co-located Secretary/Node OpenCode store selection is invalid; native CLI was not launched."
      return 1
    fi
  fi
}

opencode_command() {
  if [[ -n "${SECRETARY_OPENCODE_COMMAND:-}" ]]; then
    print -r -- "$SECRETARY_OPENCODE_COMMAND"
    return 0
  fi
  path_command opencode
}

opencode_store_command() {
  local command="$1" data_home="$2"; shift 2
  local home="$data_home/home" config_home="$data_home/config" state_home="$data_home/state" install_root="${data_home:h}"
  [[ ! -L "$install_root" && ! -L "$data_home" && ! -L "$data_home/opencode" && ! -L "$home" && ! -L "$config_home" && ! -L "$config_home/opencode" && ! -L "$state_home" ]] || { print -u2 "OpenCode native store path must not contain symlinks"; return 1; }
  mkdir -p "$data_home/opencode" "$home" "$config_home/opencode" "$state_home"
  chmod 700 "$data_home" "$data_home/opencode" "$home" "$config_home" "$config_home/opencode" "$state_home"
  (
    local variable
    for variable in ${(k)parameters}; do
      case "$variable" in
        HOME|XDG_*|OPENCODE_*|SECRETARY_*|CODEX_CONFIG|AWS_ACCESS_KEY_ID|AWS_PROFILE|AWS_DEFAULT_PROFILE|AWS_SHARED_CREDENTIALS_FILE|AWS_CONFIG_FILE|AWS_WEB_IDENTITY_TOKEN_FILE|AWS_CONTAINER_CREDENTIALS_FULL_URI|AWS_CONTAINER_CREDENTIALS_RELATIVE_URI|GOOGLE_APPLICATION_CREDENTIALS|AZURE_CONFIG_DIR|*_API_KEY|*_AUTH_TOKEN|*_ACCESS_TOKEN|*_REFRESH_TOKEN|*_CLIENT_SECRET|*_SECRET_ACCESS_KEY|*_SESSION_TOKEN|*_PASSWORD|*_CREDENTIALS_FILE|*_CREDENTIALS|*_TOKEN) unset "$variable" ;;
      esac
    done
    umask 077
    export HOME="$home" XDG_DATA_HOME="$data_home" XDG_CONFIG_HOME="$config_home" XDG_STATE_HOME="$state_home" XDG_CACHE_HOME="$home/.cache"
    export OPENCODE_CONFIG_DIR="$config_home/opencode" OPENCODE_CONFIG= OPENCODE_CONFIG_CONTENT=
    export OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_SERVER_URL= OPENCODE_SERVER_PASSWORD= OPENCODE_SERVER_USERNAME=
    "$command" "$@"
  )
}

opencode_store_initialize() {
  local command="$1" data_home="$2" database="$2/opencode/opencode.db"
  if [[ -L "$database" || ( -e "$database" && ! -f "$database" ) ]]; then
    print -u2 "OpenCode native DB path is unsafe; setup stopped."
    return 1
  fi
  [[ -f "$database" ]] && return 0
  if ! opencode_store_command "$command" "$data_home" serve --port 0 --stdio </dev/null >/dev/null 2>&1; then
    print -u2 "OpenCode native DB initialization failed; setup stopped."
    return 1
  fi
  if [[ ! -f "$database" || -L "$database" ]]; then
    print -u2 "OpenCode native DB initialization returned without creating the expected database; setup stopped."
    return 1
  fi
}

opencode_auth_ready() {
  local command="$1" data_home="$2" output lower
  if ! output="$(opencode_store_command "$command" "$data_home" auth list 2>/dev/null)"; then
    return 1
  fi
  lower="${output:l}"
  [[ -n "${output//[[:space:]]/}" && "$lower" != *'[]'* && "$lower" != *'no authenticated'* && "$lower" != *'not authenticated'* && "$lower" != *'no auth'* ]]
}

opencode_login() {
  local mode data_home command
  resolve_secretary_opencode_stores || return 1
  mode="$SELECTED_SECRETARY_MODE"
  if [[ "$mode" == "legacy" ]]; then
    print -u2 "Migration required: Secretary sessions remain pinned to the legacy OpenCode store. Login is not redirected to a new store."
    return 1
  fi
  [[ "$mode" == "isolated" || "$mode" == "shared" ]] || { print -u2 "Secretary OpenCode store selection is invalid"; return 1; }
  command="$(opencode_command)" || { print -u2 "OpenCode v2 is unavailable; install it before provider login"; return 1; }
  data_home="$SELECTED_SECRETARY_DATA_HOME"
  print "Starting explicit provider login in the selected Secretary/local Node store. No personal OpenCode credentials are imported."
  opencode_store_command "$command" "$data_home" auth login
}

node_opencode_login() {
  local mode command data_home
  validate_node_opencode_selection || return 1
  mode="$SELECTED_NODE_MODE"
  if [[ "$mode" == "legacy" ]]; then
    print -u2 "Migration required: Node is preserving its legacy OpenCode store. Provider login is not redirected to a new empty store."
    return 1
  fi
  command="$(opencode_command)" || { print -u2 "OpenCode v2 is unavailable; install it before provider login"; return 1; }
  [[ "$mode" == "isolated" || "$mode" == "shared" ]] || { print -u2 "Node OpenCode store selection is invalid"; return 1; }
  data_home="$SELECTED_NODE_DATA_HOME"
  print "Starting explicit provider login in the selected Node native store. No personal OpenCode credentials are imported."
  opencode_store_command "$command" "$data_home" auth login
}

json_safe_value() {
  [[ "$1" != *'"'* && "$1" != *'\\'* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]
}

ensure_node_config() {
  [[ ! -L "$NODE_STATE" && ! -L "$NODE_DATA" ]] || { print -u2 "Node installation data path must not be a symlink"; return 1; }
  mkdir -p "$NODE_STATE" "$NODE_DATA"
  chmod 700 "$NODE_STATE" "$NODE_DATA"
  if [[ ! -f "$NODE_CONFIG" ]]; then
    local server="${SECRETARY_NODE_SERVER:-$URL}"
    local name="${SECRETARY_NODE_NAME:-$(hostname 2>/dev/null || print node)}"
    name="$(print -r -- "$name" | tr -cd 'A-Za-z0-9._-')"
    [[ -n "$name" ]] || name="node"
    json_safe_value "$server" && json_safe_value "$name" || { print -u2 "Node config values contain unsupported characters"; return 1; }
    /bin/cat > "$NODE_CONFIG" <<EOF
{
  "server_url": "$server",
  "node": "$name",
  "data_dir": "$NODE_DATA",
  "capacity": 1,
  "include_opencode": true,
  "workspaces": []
}
EOF
    chmod 600 "$NODE_CONFIG"
  fi
}

setup() {
  [[ ! -L "$STATE" ]] || { print -u2 "Secretary data directory must not be a symlink"; return 1; }
  mkdir -p "$BIN" "$STATE"
  chmod 700 "$STATE"
  build
  resolve_secretary_opencode_stores || return 1
  local secretary_store_mode="$SELECTED_SECRETARY_MODE" secretary_data_home="$SELECTED_SECRETARY_DATA_HOME"
  local node_store_mode="$SELECTED_LOCAL_NODE_MODE" node_data_home="$SELECTED_LOCAL_NODE_DATA_HOME"
  if [[ "$secretary_store_mode" == "isolated" || "$secretary_store_mode" == "shared" ]]; then ensure_private_opencode_store "$secretary_data_home"; fi
  ensure_config
  write_bootstrap_environment
  ensure_node_config
  local harness="$(configured_harness)" opencode_bin
  if [[ "$secretary_store_mode" != "legacy" || "$node_store_mode" != "legacy" ]]; then
    if ! opencode_bin="$(opencode_command 2>/dev/null)"; then
      print -u2 "OpenCode v2 is required to initialize the selected native database; setup stopped."
      return 1
    fi
    if [[ "$secretary_store_mode" == "isolated" || "$secretary_store_mode" == "shared" ]]; then
      opencode_store_initialize "$opencode_bin" "$secretary_data_home" || return 1
    fi
    if [[ ( "$node_store_mode" == "isolated" || "$node_store_mode" == "shared" ) && "$node_data_home" != "$secretary_data_home" ]]; then
      opencode_store_initialize "$opencode_bin" "$node_data_home" || return 1
    fi
  fi
  case "$harness" in
    codex)
      if ! path_command codex-acp >/dev/null 2>&1; then
        npm install -g @agentclientprotocol/codex-acp@1.10.0
      fi
      local codex_bin
      if ! codex_bin="$(path_command codex)"; then
        print -u2 "Codex is not installed. Install Codex, then run: sex doctor"
        return 1
      fi
      if ! "$codex_bin" login status >/dev/null 2>&1; then
        print "Codex login is required. Opening Codex login now."
        "$codex_bin" login
      fi
      ;;
    fx|opencode)
      if ! harness_command >/dev/null 2>&1; then
        print -u2 "Configured harness '$harness' is unavailable. Install it, then run: sex doctor"
        return 1
      fi
      ;;
    *)
      print -u2 "Unsupported runtime harness '$harness' in $STATE/config.toml"
      return 1
      ;;
  esac
  ln -sfn "$ROOT/sex" "$BIN/sex"
  if [[ "$secretary_store_mode" == "shared" && "$node_store_mode" == "shared" && "$secretary_data_home" == "$node_data_home" ]]; then
    print "OpenCode shared Secretary/local Node native store: $secretary_data_home (provider login is separate; run: sex opencode login)"
  elif [[ "$secretary_store_mode" == "legacy" || "$node_store_mode" == "legacy" ]]; then
    print "Migration required: preserving existing OpenCode stores until owner-approved migration."
  elif [[ "$secretary_data_home" == "$node_data_home" ]]; then
    print "OpenCode Secretary and local Node selections already use the same native store: $secretary_data_home"
  elif [[ "$SELECTED_LOCAL_NODE_STANDALONE" == "true" ]]; then
    print "Standalone Node keeps its independent OpenCode native store: $node_data_home"
  else
    print "Existing Secretary and local Node OpenCode stores remain separate and unchanged. Run sex opencode select-shared-store only after confirming no managed OpenCode sessions remain."
  fi
  print "Setup complete. Run: sex start"
  print "Full-access trusted Node policy: explicit and enabled for local Node only."
}

node_setup() {
  local standalone=false standalone_explicit=false
  for option in "$@"; do
    if [[ "$option" == "--standalone" ]]; then
      standalone=true
      standalone_explicit=true
    fi
  done
  [[ -x "$NODE_BIN" ]] || build >/dev/null
  export PATH="$BIN:/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin"
  rehash
  [[ ! -L "$NODE_STATE" && ! -L "$NODE_DATA" ]] || { print -u2 "Node installation data path must not be a symlink"; return 1; }
  if [[ -f "$NODE_CONFIG" ]]; then
    validate_node_opencode_selection || return 1
    [[ "$SELECTED_NODE_DATA_DIR" == "${NODE_DATA:a}" ]] || { print -u2 "Node setup will not rewrite a deployment with a different data_dir"; return 1; }
    if [[ "$standalone_explicit" != "true" ]]; then
      standalone="$SELECTED_NODE_STANDALONE"
    fi
  fi
  mkdir -p "$NODE_STATE" "$NODE_DATA"
  chmod 700 "$NODE_STATE" "$NODE_DATA"
  if [[ "$standalone" == "true" ]]; then
    : # A remote/independent Node owns its own native store.
  elif [[ -f "$STATE/config.toml" || -f "$STATE/secretary.db" ]]; then
    "$BIN/secretaryd" --data-dir "$STATE" --select-opencode-stores
  else
    print -u2 "No local Secretary installation found; use: sex node setup --standalone --server URL"
    return 1
  fi
  if [[ "$standalone" == "true" ]]; then
    "$NODE_BIN" --data-dir "$NODE_DATA" --standalone --select-opencode-store
  else
    "$NODE_BIN" --data-dir "$NODE_DATA" --select-opencode-store
  fi
  local server="${SECRETARY_NODE_SERVER:-$URL}" name="${SECRETARY_NODE_NAME:-$(hostname 2>/dev/null || print node)}" capacity=1 include_opencode=true workspace_json="" spec project workspace_path opencode_bin
  while (($#)); do
    case "$1" in
      --server) shift; (($#)) || { print -u2 "--server requires a value"; return 2; }; server="$1" ;;
      --name) shift; (($#)) || { print -u2 "--name requires a value"; return 2; }; name="$1" ;;
      --capacity) shift; (($#)) || { print -u2 "--capacity requires a value"; return 2; }; capacity="$1" ;;
      --include-opencode) include_opencode=true ;;
      --exclude-opencode) include_opencode=false ;;
      --standalone) standalone=true ;;
      --workspace) shift; (($#)) || { print -u2 "--workspace requires project=path"; return 2; }; spec="$1"; project="${spec%%=*}"; workspace_path="${spec#*=}"; [[ "$project" != "$spec" && "$workspace_path" == /* ]] || { print -u2 "--workspace requires project=absolute-path"; return 2; }; json_safe_value "$project" && json_safe_value "$workspace_path" || { print -u2 "workspace contains unsupported characters"; return 2; }; [[ -z "$workspace_json" ]] || workspace_json+=","; workspace_json+="{\"project_id\":\"$project\",\"path\":\"$workspace_path\"}" ;;
      *) print -u2 "Unknown node setup option: $1"; return 2 ;;
    esac
    shift
  done
  name="$(print -r -- "$name" | /usr/bin/tr -cd 'A-Za-z0-9._-')"; [[ -n "$name" ]] || name="node"
  json_safe_value "$server" || { print -u2 "server URL contains unsupported characters"; return 2; }
  umask 077
  /bin/cat > "$NODE_CONFIG" <<EOF
{
  "server_url": "$server",
  "node": "$name",
  "data_dir": "$NODE_DATA",
  "capacity": $capacity,
  "include_opencode": $include_opencode,
  "standalone": $standalone,
  "workspaces": [$workspace_json]
}
EOF
  /bin/chmod 600 "$NODE_CONFIG"
  validate_node_opencode_selection || return 1
  local store_mode="$SELECTED_NODE_MODE" data_home="$SELECTED_NODE_DATA_HOME"
  if [[ "$store_mode" == "isolated" || "$store_mode" == "shared" ]]; then
    ensure_private_opencode_store "$data_home"
    if [[ "$include_opencode" == "true" ]]; then
      if ! opencode_bin="$(opencode_command 2>/dev/null)"; then
        print -u2 "OpenCode v2 is required to initialize the Node native database; Node setup stopped."
        return 1
      fi
      opencode_store_initialize "$opencode_bin" "$data_home" || return 1
    fi
    print "OpenCode Node native store: $data_home (provider login is separate; run: sex node opencode login)"
  else
    print "Migration required: preserving the existing OpenCode native store until owner-approved migration."
  fi
  print "Node setup complete: $name"
  print "Private-network-first: Node uses outbound connection only; no inbound Node port."
}

opencode_select_shared_store() {
  if running_pid >/dev/null; then
    print -u2 "Stop Secretary before selecting the shared OpenCode store: sex stop"
    return 1
  fi
  if node_running_pid >/dev/null; then
    print -u2 "Stop the co-located Node before selecting the shared OpenCode store: sex node stop"
    return 1
  fi
  local response_code="$(server_http_code)"
  if [[ "$response_code" != "000" ]]; then
    print -u2 "A Secretary server is still reachable at $URL; stop it before selecting the shared OpenCode store"
    return 1
  fi
  [[ -x "$BIN/secretaryd" ]] || { print -u2 "secretaryd is not installed; run sex setup first"; return 1; }
  "$BIN/secretaryd" --data-dir "$STATE" --select-shared-opencode-store || return 1
  print "shared Secretary and local Node store selected; no credentials or history were imported"
  print "Next, run: sex opencode login"
}

node_running_pid() {
  [[ -f "$NODE_PID_FILE" ]] || return 1
  local pid; pid="$(<"$NODE_PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  print -r -- "$pid"
}

node_start() {
  ensure_node_config || return 1
  [[ -x "$NODE_BIN" ]] || { print -u2 "secretary-node is not installed. Run: sex setup"; return 1; }
  if node_running_pid >/dev/null; then print "Node is already running"; return 0; fi
  : > "$NODE_LOG_FILE"; /bin/chmod 600 "$NODE_LOG_FILE"
  SECRETARY_NODE_PAIRING_TOKEN="${SECRETARY_NODE_PAIRING_TOKEN:-}" nohup "$NODE_BIN" --config "$NODE_CONFIG" >>"$NODE_LOG_FILE" 2>&1 &
  print -r -- "$!" > "$NODE_PID_FILE"; /bin/chmod 600 "$NODE_PID_FILE"
  print "Node started: $(node_config_value node)"
}

node_stop() {
  local pid
  if ! pid="$(node_running_pid)"; then rm -f "$NODE_PID_FILE"; print "Node is not running"; return 0; fi
  kill -TERM "$pid"
  for _ in {1..40}; do
    kill -0 "$pid" 2>/dev/null || { rm -f "$NODE_PID_FILE"; print "Node stopped"; return 0; }
    sleep 0.25
  done
  print -u2 "Node did not stop. See: $NODE_LOG_FILE"; return 1
}

node_doctor() {
  local failures=0
  [[ -x "$NODE_BIN" ]] && print "ok: secretary-node" || { print "missing: $NODE_BIN"; failures=$((failures+1)); }
  [[ -f "$NODE_CONFIG" ]] && print "ok: Node deployment config" || { print "missing: $NODE_CONFIG"; failures=$((failures+1)); }
  if [[ -f "$NODE_CONFIG" ]]; then
    local name="$(node_config_value node)" data_root="" store_mode=invalid data_home="" standalone=false include_opencode=false store_selection_valid=false
    if [[ -x "$NODE_BIN" ]]; then
      if validate_node_opencode_selection; then
        store_selection_valid=true
        store_mode="$SELECTED_NODE_MODE"
        data_home="$SELECTED_NODE_DATA_HOME"
        data_root="$SELECTED_NODE_DATA_DIR"
        standalone="$SELECTED_NODE_STANDALONE"
        include_opencode="$SELECTED_NODE_INCLUDE_OPENCODE"
      else
        print "invalid: Node OpenCode store selection; native CLI was not launched"
        failures=$((failures+1))
      fi
    fi
    [[ -n "$name" ]] && print "ok: Node identity $name" || { print "missing: Node identity"; failures=$((failures+1)); }
    [[ "$(<"$NODE_CONFIG")" != *'"listen_address"'* ]] && print "ok: no inbound Node listener" || { print "invalid: inbound Node listener configured"; failures=$((failures+1)); }
    [[ -n "$data_root" && -f "$data_root/identity.json" ]] && print "ok: paired Node identity" || print "pending: Node pairing (run with SECRETARY_NODE_PAIRING_TOKEN)"
    if [[ "$standalone" == "true" ]]; then
      print "ok: standalone Node uses an independent OpenCode store"
    elif [[ "$store_mode" == "shared" && "$store_selection_valid" == "true" ]]; then
      print "ok: Secretary and local Node use one OpenCode native store"
    fi
    if [[ "$include_opencode" == "false" ]]; then
      print "ok: OpenCode probe explicitly disabled"
    elif [[ "$store_mode" == "legacy" ]]; then
      print "migration required: preserving existing OpenCode native store; owner approval is required before migration"
      failures=$((failures+1))
    elif [[ ( "$store_mode" != "isolated" && "$store_mode" != "shared" ) || ! -d "$data_home/opencode" ]]; then
      print "missing: private Node OpenCode native store; run: sex node setup"
      failures=$((failures+1))
    elif [[ "$store_selection_valid" != "true" ]]; then
      : # Go selector rejected the store; never probe native auth through an unvalidated path.
    elif ! opencode_bin="$(opencode_command 2>/dev/null)"; then
      print "missing: OpenCode binary for Node inventory"
      failures=$((failures+1))
    elif opencode_auth_ready "$opencode_bin" "$data_home"; then
      print "ok: OpenCode provider auth in selected Node store"
    else
      if [[ "$store_mode" == "shared" ]]; then
        print "missing: OpenCode provider auth in the shared store. Owner may run: sex opencode login"
      else
        print "missing: OpenCode provider auth in selected Node store. Owner may run: sex node opencode login"
      fi
      failures=$((failures+1))
    fi
  fi
  if (( failures > 0 )); then print -u2 "Node doctor found $failures problem(s)."; return 1; fi
  print "Node doctor found no problems."
}

node_control() {
  local action="$1"; shift
  local force=0
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      *) print -u2 "Unknown Node $action option: $1"; return 2 ;;
    esac
    shift
  done
  ensure_node_config || return 1
  local admin="${SECRETARY_NODE_ADMIN_TOKEN:-}" name="$(node_config_value node)" server="$(node_config_value server_url)"
  [[ -n "$admin" ]] || { print -u2 "SECRETARY_NODE_ADMIN_TOKEN is required for Node control"; return 1; }
  for other in "${SECRETARY_CLIENT_CREDENTIAL:-}" "${SECRETARY_CAPABILITY:-}" "${SECRETARY_BOOTSTRAP_TOKEN:-}" "${SECRETARY_TELEGRAM_BOT_TOKEN:-}"; do
    [[ -z "$other" || "$admin" != "$other" ]] || { print -u2 "Node admin credential must be distinct from other credential roles"; return 1; }
  done
  [[ -n "$name" && -n "$server" ]] || { print -u2 "Node identity and server URL are required"; return 1; }
  local identity_path="$NODE_DATA/identity.json"
  [[ -f "$identity_path" ]] || { print -u2 "Node identity is not paired; refusing $action"; return 1; }
  local persisted_name="$(awk -F'"' '/"node"[[:space:]]*:/ {print $4; exit}' "$identity_path")"
  [[ "$persisted_name" == "$name" ]] || { print -u2 "Node identity mismatch; refusing $action"; return 1; }
  server="${server%/}"
  local key="sex-node-$action-$(openssl rand -hex 12)"
  local -a request_args
  request_args=(-fsS -o /dev/null -H "Authorization: Bearer $admin" -H "Idempotency-Key: $key" -H "Content-Type: application/json" -X POST)
  if (( force )); then
    request_args+=(-d '{"force":true}')
  fi
  curl "${request_args[@]}" "$server/v1/nodes/$name/$action" || { print -u2 "Node $action failed"; return 1; }
  print "Node $action requested: $name"
}

node_remote_status() {
  local admin="$1" server="$2" name="$3"
  curl -fsS -H "Authorization: Bearer $admin" "$server/v1/nodes/$name"
}

node_status_idle() {
  local response="$1"
  [[ "$response" != *'"active_attempts"'* || "$response" == *'"active_attempts":[]'* || "$response" == *'"active_attempts": []'* ]]
}

node_revoke() {
  local force=0 timeout_seconds="${SECRETARY_NODE_REVOKE_TIMEOUT:-60}" poll_interval="${SECRETARY_NODE_REVOKE_POLL_INTERVAL:-1}"
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      --timeout) shift; (($#)) || { print -u2 "--timeout requires seconds"; return 2; }; timeout_seconds="$1" ;;
      --interval) shift; (($#)) || { print -u2 "--interval requires seconds"; return 2; }; poll_interval="$1" ;;
      *) print -u2 "Unknown Node revoke option: $1"; return 2 ;;
    esac
    shift
  done
  [[ "$timeout_seconds" == <-> && "$timeout_seconds" -ge 0 ]] || { print -u2 "--timeout must be a non-negative integer"; return 2; }
  ensure_node_config || return 1
  local admin="${SECRETARY_NODE_ADMIN_TOKEN:-}" name="$(node_config_value node)" server="$(node_config_value server_url)"
  [[ -n "$admin" && -n "$name" && -n "$server" ]] || { print -u2 "Node admin, identity and server URL are required"; return 1; }
  local identity_path="$NODE_DATA/identity.json"
  [[ -f "$identity_path" ]] || { print -u2 "Node identity is not paired; refusing revoke"; return 1; }
  local persisted_name="$(awk -F'"' '/"node"[[:space:]]*:/ {print $4; exit}' "$identity_path")"
  [[ "$persisted_name" == "$name" ]] || { print -u2 "Node identity mismatch; refusing revoke"; return 1; }
  server="${server%/}"
  node_control drain || return 1
  local deadline=$((SECONDS + timeout_seconds)) remote_status=""
  while true; do
    remote_status="$(node_remote_status "$admin" "$server" "$name")" || { print -u2 "Unable to read remote Node status; refusing revoke"; return 1; }
    if node_status_idle "$remote_status"; then
      break
    fi
    if (( force )); then
      print -u2 "Node still has active attempts; forcing revoke"
      break
    fi
    if (( SECONDS >= deadline )); then
      print -u2 "Node drain timed out with active attempts; refusing revoke (use --force to override)"
      return 1
    fi
    sleep "$poll_interval"
  done
  if (( force )); then
    node_control revoke --force || return 1
  else
    node_control revoke || return 1
  fi
  node_stop
}

node_install_service() {
  [[ -f "$NODE_CONFIG" ]] || { print -u2 "Node is not configured; run sex node setup first"; return 1; }
  [[ -x "$NODE_BIN" ]] || build >/dev/null
  mkdir -p "${NODE_PLIST:h}"
  cat > "$NODE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.secretary.sex-node</string>
  <key>ProgramArguments</key><array><string>$ROOT/sex</string><string>node</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>StandardOutPath</key><string>$NODE_LOG_FILE</string><key>StandardErrorPath</key><string>$NODE_LOG_FILE</string>
</dict></plist>
EOF
  /bin/chmod 600 "$NODE_PLIST"
  launchctl bootout "gui/$UID" "$NODE_PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$NODE_PLIST"
  print "Node will start after macOS login."
}

node_serve() {
  ensure_node_config || return 1
  print -r -- "$$" > "$NODE_PID_FILE"; /bin/chmod 600 "$NODE_PID_FILE"
  trap 'rm -f "$NODE_PID_FILE"' EXIT INT TERM
  exec "$NODE_BIN" --config "$NODE_CONFIG"
}

doctor() {
  local failures=0
  [[ ! -L "$STATE" ]] || { print "invalid: Secretary data directory is a symlink"; return 1; }
  mkdir -p "$STATE"
  if [[ ! -x "$BIN/secretaryd" ]]; then
    print "missing: $BIN/secretaryd"
    failures=$((failures + 1))
  else
    print "ok: secretaryd"
  fi
  if [[ ! -x "$BIN/secretary-mcp" ]]; then
    print "missing: $BIN/secretary-mcp"
    failures=$((failures + 1))
  else
    print "ok: secretary-mcp"
  fi
  local store_selection_valid=false
  local secretary_store_mode=invalid node_store_mode=invalid secretary_data_home="" node_data_home="" local_node_standalone=false
  if [[ -x "$BIN/secretaryd" ]]; then
    if resolve_secretary_opencode_stores; then
      store_selection_valid=true
      secretary_store_mode="$SELECTED_SECRETARY_MODE"
      secretary_data_home="$SELECTED_SECRETARY_DATA_HOME"
      node_store_mode="$SELECTED_LOCAL_NODE_MODE"
      node_data_home="$SELECTED_LOCAL_NODE_DATA_HOME"
      local_node_standalone="$SELECTED_LOCAL_NODE_STANDALONE"
    else
      print "invalid: Secretary/Node OpenCode store selection; native CLI was not launched"
      failures=$((failures + 1))
    fi
  fi
  if [[ "$secretary_store_mode" == "legacy" ]]; then
    print "migration required: preserving existing Secretary OpenCode store; owner approval is required before migration"
    failures=$((failures + 1))
  elif [[ "$secretary_store_mode" != "isolated" && "$secretary_store_mode" != "shared" ]]; then
    print "invalid: Secretary OpenCode store selection"
    failures=$((failures + 1))
  fi
  if [[ "$node_store_mode" == "legacy" ]]; then
    print "migration required: preserving existing local Worker Node OpenCode store; owner approval is required before migration"
    failures=$((failures + 1))
  elif [[ "$node_store_mode" != "isolated" && "$node_store_mode" != "shared" ]]; then
    print "invalid: local Worker Node OpenCode store selection"
    failures=$((failures + 1))
  fi
  if [[ "$local_node_standalone" != "true" && "$secretary_store_mode" != "legacy" && "$node_store_mode" != "legacy" && "$secretary_store_mode" != "invalid" && "$node_store_mode" != "invalid" ]]; then
    if [[ "$secretary_store_mode" != "$node_store_mode" || "$secretary_data_home" != "$node_data_home" ]]; then
      print "migration required: Secretary and local Node still have different OpenCode store selections; run sex opencode select-shared-store only when no managed OpenCode sessions remain"
      failures=$((failures + 1))
    fi
  fi
  local harness="$(configured_harness)"
  if command_path="$(harness_command 2>/dev/null)"; then
    print "ok: $harness ($command_path)"
    if [[ "$harness" == "codex" ]]; then
      local codex_path
      if codex_path="$(path_command codex 2>/dev/null)" && "$codex_path" login status >/dev/null 2>&1; then
        print "ok: codex login"
      else
        print "missing: codex login. Run: codex login"
        failures=$((failures + 1))
      fi
    elif [[ "$harness" == "opencode" ]]; then
      local data_home="$secretary_data_home"
      if [[ "$store_selection_valid" != "true" ]]; then
        : # Go selector rejected the store; never probe native auth through an unvalidated path.
      elif [[ "$secretary_store_mode" != "isolated" && "$secretary_store_mode" != "shared" ]]; then
        : # The store error was reported above; do not probe a legacy/personal store.
      elif opencode_auth_ready "$command_path" "$data_home"; then
        print "ok: OpenCode provider auth in selected Secretary store"
      else
        print "missing: OpenCode provider auth in selected Secretary store. Owner may run: sex opencode login"
        failures=$((failures + 1))
      fi
    fi
  else
    print "missing: configured harness $harness"
    failures=$((failures + 1))
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    print "missing: bootstrap environment. Run: sex setup"
    failures=$((failures + 1))
  else
    print "ok: bootstrap environment"
  fi
  if [[ -f "$STATE/config.toml" ]]; then
    print "ok: config $STATE/config.toml"
  else
    print "missing: config $STATE/config.toml"
    failures=$((failures + 1))
  fi
  if (( failures > 0 )); then
    print -u2 "Doctor found $failures problem(s)."
    return 1
  fi
  print "Doctor found no problems."
}

running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(<"$PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  print -r -- "$pid"
}

open_user() {
  load_environment
  local pairing_url="$URL/#bootstrap=$SECRETARY_BOOTSTRAP_TOKEN"
  if ! open "$pairing_url" >/dev/null 2>&1; then
    print "Open the local Secretary UI at $URL and complete pairing there."
  fi
}

server_http_code() {
  curl -sS -o /dev/null -w '%{http_code}' "$URL/v1/web/session" 2>/dev/null || true
}

start() {
  local debug=0
  while (($#)); do
    case "$1" in
      --debug) debug=1 ;;
      *) print -u2 "Unknown start option: $1"; return 2 ;;
    esac
    shift
  done
  if ! [[ -x "$BIN/secretaryd" ]]; then
    print "Secretary is not set up. Run: sex setup"
    return 1
  fi
  write_bootstrap_environment
  load_environment
  if ! running_pid >/dev/null; then
    local existing_code="$(server_http_code)"
    if [[ "$existing_code" == "200" || "$existing_code" == "401" ]]; then
      print -u2 "A Secretary server is already listening at $URL but is not managed by this state directory. Stop it first, then run sex start again."
      return 1
    fi
  fi
  if running_pid >/dev/null; then
    local wanted="normal"
    (( debug )) && wanted="debug"
    local current="normal"
    [[ -f "$MODE_FILE" ]] && current="$(<"$MODE_FILE")"
    if [[ "$current" != "$wanted" ]]; then
      print "Secretary is running in $current mode. Restarting in $wanted mode."
      stop
    else
      open_user
      print "Secretary is already running at $URL"
      (( debug )) && print "Control Room: $URL/control-room"
      return 0
    fi
  fi
  : "${SECRETARY_BOOTSTRAP_TOKEN:?missing bootstrap token}"
  local harness="$(configured_harness)"
  local harness_bin
  if ! harness_bin="$(harness_command 2>/dev/null)"; then
    print -u2 "Configured harness '$harness' is unavailable. Run: sex doctor"
    return 1
  fi
  : > "$LOG_FILE"
  chmod 600 "$LOG_FILE"
  local -a args
  args=("$BIN/secretaryd" -data-dir "$STATE" -listen 127.0.0.1:8081)
  (( debug )) && args+=(--debug)
  local acp_bin="" fx_bin="" opencode_bin="" codex_path=""
  [[ "$harness" == "codex" ]] && acp_bin="$harness_bin"
  [[ "$harness" == "codex" ]] && codex_path="$(path_command codex 2>/dev/null || true)"
  [[ "$harness" == "fx" ]] && fx_bin="$harness_bin"
  [[ "$harness" == "opencode" ]] && opencode_bin="$harness_bin"
  PATH="$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH" \
  CODEX_PATH="$codex_path" \
  NO_BROWSER=1 \
  SECRETARY_ACP_COMMAND="$acp_bin" \
  SECRETARY_FX_COMMAND="$fx_bin" \
  SECRETARY_OPENCODE_COMMAND="$opencode_bin" \
  SECRETARY_CAPABILITY_FILE="$CAPABILITY_FILE" \
  nohup "${args[@]}" >>"$LOG_FILE" 2>&1 &
  print -r -- "$!" > "$PID_FILE"
  chmod 600 "$PID_FILE"
  (( debug )) && print "debug" > "$MODE_FILE" || print "normal" > "$MODE_FILE"
  chmod 600 "$MODE_FILE"
  local code
  for _ in {1..80}; do
    code="$(server_http_code)"
    if [[ "$code" == "200" || "$code" == "401" ]]; then
      if [[ -z "${SECRETARY_CAPABILITY:-}" ]]; then
        local capability=""
        [[ -f "$CAPABILITY_FILE" ]] && capability="$(<"$CAPABILITY_FILE")"
        if [[ -n "$capability" ]]; then
          printf "export SECRETARY_CAPABILITY='%s'\n" "$capability" >> "$ENV_FILE"
          chmod 600 "$ENV_FILE" "$CAPABILITY_FILE"
        fi
      fi
      open_user
      print "Secretary started at $URL"
      (( debug )) && print "Control Room: $URL/control-room"
      return 0
    fi
    sleep 0.25
  done
  print -u2 "Secretary did not become ready. See: $LOG_FILE"
  return 1
}

stop() {
  local pid
  if ! pid="$(running_pid)"; then
    rm -f "$PID_FILE" "$MODE_FILE"
    print "Secretary is not running"
    return 0
  fi
  kill -TERM "$pid"
  for _ in {1..40}; do
    kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE" "$MODE_FILE"; print "Secretary stopped"; return 0; }
    sleep 0.25
  done
  print -u2 "Secretary did not stop. See: $LOG_FILE"
  return 1
}

restart() {
  local -a options
  while (($#)); do
    case "$1" in
      --debug) options+=(--debug) ;;
      *) print -u2 "Unknown restart option: $1"; return 2 ;;
    esac
    shift
  done
  stop
  start "${options[@]}"
}

install_service() {
  local debug=0
  while (($#)); do
    case "$1" in
      --debug) debug=1 ;;
      *) print -u2 "Unknown install-service option: $1"; return 2 ;;
    esac
    shift
  done
  setup
  mkdir -p "${PLIST:h}"
  local debug_arg=""
  (( debug )) && debug_arg='<string>--debug</string>'
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.secretary.sex</string>
  <key>ProgramArguments</key><array><string>$ROOT/sex</string><string>serve</string>$debug_arg</array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
  launchctl bootout "gui/$UID" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$PLIST"
  print "Secretary will start after macOS login."
}

serve() {
  local -a options
  while (($#)); do
    case "$1" in
      --debug) options+=(--debug) ;;
      *) print -u2 "Unknown serve option: $1"; return 2 ;;
    esac
    shift
  done
  write_bootstrap_environment
  load_environment
  local harness="$(configured_harness)"
  local harness_bin
  harness_bin="$(harness_command 2>/dev/null)" || { print -u2 "Configured harness '$harness' is unavailable. Run: sex doctor"; return 1; }
  local -a env_args
  local codex_path=""
  [[ "$harness" == "codex" ]] && codex_path="$(path_command codex 2>/dev/null || true)"
  env_args=(PATH="$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH" CODEX_PATH="$codex_path" NO_BROWSER=1 SECRETARY_CAPABILITY_FILE="$CAPABILITY_FILE")
  case "$harness" in
    codex) env_args+=(SECRETARY_ACP_COMMAND="$harness_bin") ;;
    fx) env_args+=(SECRETARY_FX_COMMAND="$harness_bin") ;;
    opencode) env_args+=(SECRETARY_OPENCODE_COMMAND="$harness_bin") ;;
  esac
  print -r -- "$$" > "$PID_FILE"
  chmod 600 "$PID_FILE"
  local mode="normal"
  (( ${#options[@]} > 0 )) && mode="debug"
  print -r -- "$mode" > "$MODE_FILE"
  chmod 600 "$MODE_FILE"
  exec env "${env_args[@]}" "$BIN/secretaryd" -data-dir "$STATE" -listen 127.0.0.1:8081 "${options[@]}"
}

case "${1:-}" in
  setup) shift; setup "$@" ;;
  start) shift; start "$@" ;;
  stop) shift; stop "$@" ;;
  restart) shift; restart "$@" ;;
  status)
    if pid="$(running_pid)"; then
      mode="normal"; [[ -f "$MODE_FILE" ]] && mode="$(<"$MODE_FILE")"
      print "running pid=$pid mode=$mode url=$URL"
      if [[ "$mode" == "debug" ]]; then
        print "control-room=$URL/control-room"
      fi
      return 0
    else
      print "stopped"
      return 0
    fi
    ;;
  logs) tail -f "$LOG_FILE" ;;
  doctor) shift; doctor "$@" ;;
  opencode)
    shift
    case "${1:-}" in
      login) shift; opencode_login "$@" ;;
      select-shared-store) shift; opencode_select_shared_store "$@" ;;
      *) print -u2 "usage: sex opencode {login|select-shared-store}"; return 2 ;;
    esac
    ;;
  node)
    shift
    case "${1:-}" in
      setup) shift; node_setup "$@" ;;
      start) shift; node_start "$@" ;;
      stop) shift; node_stop "$@" ;;
      status)
        if pid="$(node_running_pid)"; then print "Node running pid=$pid identity=$(node_config_value node) outbound-only"; else print "Node stopped identity=$(node_config_value node 2>/dev/null || print unknown) outbound-only"; fi
        ;;
      logs) shift; tail -f "$NODE_LOG_FILE" ;;
      doctor) shift; node_doctor "$@" ;;
      opencode)
        shift
        case "${1:-}" in
          login) shift; node_opencode_login "$@" ;;
          *) print -u2 "usage: sex node opencode login"; return 2 ;;
        esac
        ;;
      drain) shift; node_control drain "$@" ;;
      revoke) shift; node_revoke "$@" ;;
      install-service) shift; node_install_service "$@" ;;
      uninstall-service) launchctl bootout "gui/$UID" "$NODE_PLIST" 2>/dev/null || true; rm -f "$NODE_PLIST"; print "Node service removed" ;;
      serve) shift; node_serve "$@" ;;
      *) print -u2 "usage: sex node {setup|start|stop|status|logs|doctor|drain|revoke|install-service|uninstall-service|serve}"; return 2 ;;
    esac
    ;;
  install-service) shift; install_service "$@" ;;
  uninstall-service) launchctl bootout "gui/$UID" "$PLIST" 2>/dev/null || true; rm -f "$PLIST"; print "Service removed" ;;
  serve) shift; serve "$@" ;;
  *) usage ;;
esac
