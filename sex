#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h}"
STATE="$HOME/.local/share/secretary"
BIN="$HOME/.local/bin"
ENV_FILE="$STATE/environment"
PID_FILE="$STATE/server.pid"
MODE_FILE="$STATE/server.mode"
LOG_FILE="$STATE/secretaryd.log"
CAPABILITY_FILE="$STATE/secretary-runtime-credential"
NODE_STATE="$STATE/node"
NODE_CONFIG="$NODE_STATE/config.json"
NODE_DATA="$NODE_STATE/data"
NODE_BIN="$BIN/secretary-node"
MIGRATE_BIN="$BIN/secretary-migrate"
NODE_PID_FILE="$NODE_STATE/node.pid"
NODE_LOG_FILE="$NODE_STATE/secretary-node.log"
NODE_PLIST="$HOME/Library/LaunchAgents/dev.secretary.sex-node.plist"
PLIST="$HOME/Library/LaunchAgents/dev.secretary.sex.plist"
URL="http://127.0.0.1:8081"

usage() {
  cat <<'EOF'
Usage: sex <command> [options]

Commands:
  setup             Build Secretary and install/check the configured harness
  start [--debug]   Start or reuse the server and open the User UI
  stop              Stop the local Secretary server
  restart [--debug] Restart the server and open the User UI
  status            Show server status and mode
  logs              Follow the server log
  doctor            Check paths, binaries, config, and harness readiness
  install-service [--debug]
                    Install a launchd service that survives terminal exit
  uninstall-service Remove the launchd service
  node setup       Configure a private outbound Execution Node
  node start|stop|status|logs|doctor
                    Manage the local Execution Node process
  node drain|revoke Safely drain or revoke the configured Node
                    revoke waits for remote active work; use --force only to override
  node install-service|uninstall-service
                    Manage the Node launchd service
EOF
}

load_environment() {
  [[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
}

write_bootstrap_environment() {
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  if [[ ! -f "$ENV_FILE" ]]; then
    umask 077
    printf "export SECRETARY_BOOTSTRAP_TOKEN='%s'\n" "$(openssl rand -hex 32)" > "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
}

configured_harness() {
  local config="$STATE/config.toml"
  if [[ -f "$config" ]]; then
    local harness
    harness="$(awk -F'=' '/^[[:space:]]*harness[[:space:]]*=/{gsub(/[ "\r]/, "", $2); print $2; exit}' "$config")"
    [[ -n "$harness" ]] && { print "$harness"; return 0; }
  fi
  print "fx"
}

path_command() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for candidate in "$BIN/$name" "$HOME/.local/share/mise/shims/$name" "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
    [[ -x "$candidate" ]] && { print "$candidate"; return 0; }
  done
  return 1
}

harness_command() {
  case "$(configured_harness)" in
    codex)
      [[ -n "${SECRETARY_ACP_COMMAND:-}" ]] && { print "$SECRETARY_ACP_COMMAND"; return 0; }
      path_command codex-acp ;;
    fx)
      [[ -n "${SECRETARY_FX_COMMAND:-}" ]] && { print "$SECRETARY_FX_COMMAND"; return 0; }
      path_command fx ;;
    opencode)
      [[ -n "${SECRETARY_OPENCODE_COMMAND:-}" ]] && { print "$SECRETARY_OPENCODE_COMMAND"; return 0; }
      path_command opencode ;;
    *) return 1 ;;
  esac
}

build() {
  mkdir -p "$BIN"
  cd "$ROOT"
  mise exec -- go build -o "$BIN/secretaryd" ./cmd/secretaryd
  mise exec -- go build -o "$BIN/secretaryctl" ./cmd/secretaryctl
  mise exec -- go build -o "$BIN/secretary-mcp" ./cmd/secretary-mcp
  mise exec -- go build -o "$MIGRATE_BIN" ./cmd/secretary-migrate
  mise exec -- go build -o "$NODE_BIN" ./cmd/secretary-node
}

ensure_config() {
  [[ -f "$STATE/config.toml" ]] && return 0
  mkdir -p "$STATE/profiles"
  cp "$ROOT/internal/config/defaults/config.toml" "$STATE/config.toml"
  cp "$ROOT/internal/config/defaults/secretary.md" "$STATE/profiles/secretary.md"
  cp "$ROOT/internal/config/defaults/worker.md" "$STATE/profiles/worker.md"
  cp "$ROOT/internal/config/defaults/child-worker.md" "$STATE/profiles/child-worker.md"
  chmod 700 "$STATE/profiles"
  chmod 600 "$STATE/config.toml" "$STATE/profiles"/*.md
}

node_config_value() {
  local key="$1"
  [[ -f "$NODE_CONFIG" ]] || return 1
  awk -F'"' -v wanted="$key" '$2 == wanted { print $4; exit }' "$NODE_CONFIG"
}

json_safe_value() {
  [[ "$1" != *'"'* && "$1" != *'\\'* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]
}

ensure_node_config() {
  [[ -f "$NODE_CONFIG" ]] && return 0
  mkdir -p "$NODE_DATA"
  local server="${SECRETARY_NODE_SERVER:-$URL}"
  local name="${SECRETARY_NODE_NAME:-$(hostname 2>/dev/null || print node)}"
  name="$(print -r -- "$name" | tr -cd 'A-Za-z0-9._-')"
  [[ -n "$name" ]] || name="node"
  json_safe_value "$server" && json_safe_value "$name" || { print -u2 "Node config values contain unsupported characters"; return 1; }
  umask 077
  /bin/cat > "$NODE_CONFIG" <<EOF
{
  "server_url": "$server",
  "node": "$name",
  "data_dir": "$NODE_DATA",
  "capacity": 1,
  "workspaces": []
}
EOF
  chmod 600 "$NODE_CONFIG"
}

setup() {
  mkdir -p "$BIN" "$STATE"
  chmod 700 "$STATE"
  build
  ensure_config
  write_bootstrap_environment
  ensure_node_config
  local harness="$(configured_harness)"
  case "$harness" in
    codex)
      if ! path_command codex-acp >/dev/null 2>&1; then
        npm install -g @agentclientprotocol/codex-acp@1.10.0
      fi
      local codex_bin
      if ! codex_bin="$(path_command codex)"; then
        print -u2 "Codex is not installed. Install Codex, then run: sex doctor"
        return 1
      fi
      if ! "$codex_bin" login status >/dev/null 2>&1; then
        print "Codex login is required. Opening Codex login now."
        "$codex_bin" login
      fi
      ;;
    fx|opencode)
      if ! harness_command >/dev/null 2>&1; then
        print -u2 "Configured harness '$harness' is unavailable. Install it, then run: sex doctor"
        return 1
      fi
      ;;
    *)
      print -u2 "Unsupported runtime harness '$harness' in $STATE/config.toml"
      return 1
      ;;
  esac
  ln -sfn "$ROOT/sex" "$BIN/sex"
  print "Setup complete. Run: sex start"
  print "Full-access trusted Node policy: explicit and enabled for local Node only."
}

node_setup() {
  [[ -x "$NODE_BIN" ]] || build >/dev/null
  export PATH="$BIN:/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin"
  rehash
  mkdir -p "$NODE_STATE" "$NODE_DATA"
  local server="${SECRETARY_NODE_SERVER:-$URL}" name="${SECRETARY_NODE_NAME:-$(hostname 2>/dev/null || print node)}" capacity=1 include_opencode=false workspace_json="" spec project path
  while (($#)); do
    case "$1" in
      --server) shift; (($#)) || { print -u2 "--server requires a value"; return 2; }; server="$1" ;;
      --name) shift; (($#)) || { print -u2 "--name requires a value"; return 2; }; name="$1" ;;
      --capacity) shift; (($#)) || { print -u2 "--capacity requires a value"; return 2; }; capacity="$1" ;;
      --include-opencode) include_opencode=true ;;
      --workspace) shift; (($#)) || { print -u2 "--workspace requires project=path"; return 2; }; spec="$1"; project="${spec%%=*}"; path="${spec#*=}"; [[ "$project" != "$spec" && "$path" == /* ]] || { print -u2 "--workspace requires project=absolute-path"; return 2; }; json_safe_value "$project" && json_safe_value "$path" || { print -u2 "workspace contains unsupported characters"; return 2; }; [[ -z "$workspace_json" ]] || workspace_json+=","; workspace_json+="{\"project_id\":\"$project\",\"path\":\"$path\"}" ;;
      *) print -u2 "Unknown node setup option: $1"; return 2 ;;
    esac
    shift
  done
  name="$(print -r -- "$name" | /usr/bin/tr -cd 'A-Za-z0-9._-')"; [[ -n "$name" ]] || name="node"
  json_safe_value "$server" || { print -u2 "server URL contains unsupported characters"; return 2; }
  umask 077
  /bin/cat > "$NODE_CONFIG" <<EOF
{
  "server_url": "$server",
  "node": "$name",
  "data_dir": "$NODE_DATA",
  "capacity": $capacity,
  "include_opencode": $include_opencode,
  "workspaces": [$workspace_json]
}
EOF
  /bin/chmod 600 "$NODE_CONFIG"
  print "Node setup complete: $name"
  print "Private-network-first: Node uses outbound connection only; no inbound Node port."
}

node_running_pid() {
  [[ -f "$NODE_PID_FILE" ]] || return 1
  local pid; pid="$(<"$NODE_PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  print -r -- "$pid"
}

node_start() {
  ensure_node_config || return 1
  [[ -x "$NODE_BIN" ]] || { print -u2 "secretary-node is not installed. Run: sex setup"; return 1; }
  if node_running_pid >/dev/null; then print "Node is already running"; return 0; fi
  : > "$NODE_LOG_FILE"; /bin/chmod 600 "$NODE_LOG_FILE"
  SECRETARY_NODE_PAIRING_TOKEN="${SECRETARY_NODE_PAIRING_TOKEN:-}" nohup "$NODE_BIN" --config "$NODE_CONFIG" >>"$NODE_LOG_FILE" 2>&1 &
  print -r -- "$!" > "$NODE_PID_FILE"; /bin/chmod 600 "$NODE_PID_FILE"
  print "Node started: $(node_config_value node)"
}

node_stop() {
  local pid
  if ! pid="$(node_running_pid)"; then rm -f "$NODE_PID_FILE"; print "Node is not running"; return 0; fi
  kill -TERM "$pid"
  for _ in {1..40}; do
    kill -0 "$pid" 2>/dev/null || { rm -f "$NODE_PID_FILE"; print "Node stopped"; return 0; }
    sleep 0.25
  done
  print -u2 "Node did not stop. See: $NODE_LOG_FILE"; return 1
}

node_doctor() {
  local failures=0
  [[ -x "$NODE_BIN" ]] && print "ok: secretary-node" || { print "missing: $NODE_BIN"; failures=$((failures+1)); }
  [[ -f "$NODE_CONFIG" ]] && print "ok: Node deployment config" || { print "missing: $NODE_CONFIG"; failures=$((failures+1)); }
  if [[ -f "$NODE_CONFIG" ]]; then
    local name="$(node_config_value node)"
    [[ -n "$name" ]] && print "ok: Node identity $name" || { print "missing: Node identity"; failures=$((failures+1)); }
    [[ "$(<"$NODE_CONFIG")" != *'"listen_address"'* ]] && print "ok: no inbound Node listener" || { print "invalid: inbound Node listener configured"; failures=$((failures+1)); }
    [[ -f "$NODE_DATA/identity.json" ]] && print "ok: paired Node identity" || print "pending: Node pairing (run with SECRETARY_NODE_PAIRING_TOKEN)"
  fi
  if (( failures > 0 )); then print -u2 "Node doctor found $failures problem(s)."; return 1; fi
  print "Node doctor found no problems."
}

node_control() {
  local action="$1"; shift
  local force=0
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      *) print -u2 "Unknown Node $action option: $1"; return 2 ;;
    esac
    shift
  done
  ensure_node_config || return 1
  local admin="${SECRETARY_NODE_ADMIN_TOKEN:-}" name="$(node_config_value node)" server="$(node_config_value server_url)"
  [[ -n "$admin" ]] || { print -u2 "SECRETARY_NODE_ADMIN_TOKEN is required for Node control"; return 1; }
  for other in "${SECRETARY_CLIENT_CREDENTIAL:-}" "${SECRETARY_CAPABILITY:-}" "${SECRETARY_BOOTSTRAP_TOKEN:-}" "${SECRETARY_TELEGRAM_BOT_TOKEN:-}"; do
    [[ -z "$other" || "$admin" != "$other" ]] || { print -u2 "Node admin credential must be distinct from other credential roles"; return 1; }
  done
  [[ -n "$name" && -n "$server" ]] || { print -u2 "Node identity and server URL are required"; return 1; }
  local identity_path="$NODE_DATA/identity.json"
  [[ -f "$identity_path" ]] || { print -u2 "Node identity is not paired; refusing $action"; return 1; }
  local persisted_name="$(awk -F'"' '/"node"[[:space:]]*:/ {print $4; exit}' "$identity_path")"
  [[ "$persisted_name" == "$name" ]] || { print -u2 "Node identity mismatch; refusing $action"; return 1; }
  server="${server%/}"
  local key="sex-node-$action-$(openssl rand -hex 12)"
  local -a request_args
  request_args=(-fsS -o /dev/null -H "Authorization: Bearer $admin" -H "Idempotency-Key: $key" -H "Content-Type: application/json" -X POST)
  if (( force )); then
    request_args+=(-d '{"force":true}')
  fi
  curl "${request_args[@]}" "$server/v1/nodes/$name/$action" || { print -u2 "Node $action failed"; return 1; }
  print "Node $action requested: $name"
}

node_remote_status() {
  local admin="$1" server="$2" name="$3"
  curl -fsS -H "Authorization: Bearer $admin" "$server/v1/nodes/$name"
}

node_status_idle() {
  local response="$1"
  [[ "$response" != *'"active_attempts"'* || "$response" == *'"active_attempts":[]'* || "$response" == *'"active_attempts": []'* ]]
}

node_revoke() {
  local force=0 timeout_seconds="${SECRETARY_NODE_REVOKE_TIMEOUT:-60}" poll_interval="${SECRETARY_NODE_REVOKE_POLL_INTERVAL:-1}"
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      --timeout) shift; (($#)) || { print -u2 "--timeout requires seconds"; return 2; }; timeout_seconds="$1" ;;
      --interval) shift; (($#)) || { print -u2 "--interval requires seconds"; return 2; }; poll_interval="$1" ;;
      *) print -u2 "Unknown Node revoke option: $1"; return 2 ;;
    esac
    shift
  done
  [[ "$timeout_seconds" == <-> && "$timeout_seconds" -ge 0 ]] || { print -u2 "--timeout must be a non-negative integer"; return 2; }
  ensure_node_config || return 1
  local admin="${SECRETARY_NODE_ADMIN_TOKEN:-}" name="$(node_config_value node)" server="$(node_config_value server_url)"
  [[ -n "$admin" && -n "$name" && -n "$server" ]] || { print -u2 "Node admin, identity and server URL are required"; return 1; }
  local identity_path="$NODE_DATA/identity.json"
  [[ -f "$identity_path" ]] || { print -u2 "Node identity is not paired; refusing revoke"; return 1; }
  local persisted_name="$(awk -F'"' '/"node"[[:space:]]*:/ {print $4; exit}' "$identity_path")"
  [[ "$persisted_name" == "$name" ]] || { print -u2 "Node identity mismatch; refusing revoke"; return 1; }
  server="${server%/}"
  node_control drain || return 1
  local deadline=$((SECONDS + timeout_seconds)) remote_status=""
  while true; do
    remote_status="$(node_remote_status "$admin" "$server" "$name")" || { print -u2 "Unable to read remote Node status; refusing revoke"; return 1; }
    if node_status_idle "$remote_status"; then
      break
    fi
    if (( force )); then
      print -u2 "Node still has active attempts; forcing revoke"
      break
    fi
    if (( SECONDS >= deadline )); then
      print -u2 "Node drain timed out with active attempts; refusing revoke (use --force to override)"
      return 1
    fi
    sleep "$poll_interval"
  done
  if (( force )); then
    node_control revoke --force || return 1
  else
    node_control revoke || return 1
  fi
  node_stop
}

node_install_service() {
  setup >/dev/null
  mkdir -p "${NODE_PLIST:h}"
  cat > "$NODE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.secretary.sex-node</string>
  <key>ProgramArguments</key><array><string>$ROOT/sex</string><string>node</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>StandardOutPath</key><string>$NODE_LOG_FILE</string><key>StandardErrorPath</key><string>$NODE_LOG_FILE</string>
</dict></plist>
EOF
  /bin/chmod 600 "$NODE_PLIST"
  launchctl bootout "gui/$UID" "$NODE_PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$NODE_PLIST"
  print "Node will start after macOS login."
}

node_serve() {
  ensure_node_config || return 1
  print -r -- "$$" > "$NODE_PID_FILE"; /bin/chmod 600 "$NODE_PID_FILE"
  trap 'rm -f "$NODE_PID_FILE"' EXIT INT TERM
  exec "$NODE_BIN" --config "$NODE_CONFIG"
}

doctor() {
  local failures=0
  mkdir -p "$STATE"
  if [[ ! -x "$BIN/secretaryd" ]]; then
    print "missing: $BIN/secretaryd"
    failures=$((failures + 1))
  else
    print "ok: secretaryd"
  fi
  if [[ ! -x "$BIN/secretary-mcp" ]]; then
    print "missing: $BIN/secretary-mcp"
    failures=$((failures + 1))
  else
    print "ok: secretary-mcp"
  fi
  local harness="$(configured_harness)"
  if command_path="$(harness_command 2>/dev/null)"; then
    print "ok: $harness ($command_path)"
    if [[ "$harness" == "codex" ]]; then
      local codex_path
      if codex_path="$(path_command codex 2>/dev/null)" && "$codex_path" login status >/dev/null 2>&1; then
        print "ok: codex login"
      else
        print "missing: codex login. Run: codex login"
        failures=$((failures + 1))
      fi
    fi
  else
    print "missing: configured harness $harness"
    failures=$((failures + 1))
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    print "missing: bootstrap environment. Run: sex setup"
    failures=$((failures + 1))
  else
    print "ok: bootstrap environment"
  fi
  if [[ -f "$STATE/config.toml" ]]; then
    print "ok: config $STATE/config.toml"
  else
    print "missing: config $STATE/config.toml"
    failures=$((failures + 1))
  fi
  if (( failures > 0 )); then
    print -u2 "Doctor found $failures problem(s)."
    return 1
  fi
  print "Doctor found no problems."
}

running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(<"$PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  print -r -- "$pid"
}

open_user() {
  load_environment
  local pairing_url="$URL/#bootstrap=$SECRETARY_BOOTSTRAP_TOKEN"
  if ! open "$pairing_url" >/dev/null 2>&1; then
    print "Open the local Secretary UI at $URL and complete pairing there."
  fi
}

server_http_code() {
  curl -sS -o /dev/null -w '%{http_code}' "$URL/v1/web/session" 2>/dev/null || true
}

start() {
  local debug=0
  while (($#)); do
    case "$1" in
      --debug) debug=1 ;;
      *) print -u2 "Unknown start option: $1"; return 2 ;;
    esac
    shift
  done
  if ! [[ -x "$BIN/secretaryd" ]]; then
    print "Secretary is not set up. Run: sex setup"
    return 1
  fi
  write_bootstrap_environment
  load_environment
  if ! running_pid >/dev/null; then
    local existing_code="$(server_http_code)"
    if [[ "$existing_code" == "200" || "$existing_code" == "401" ]]; then
      print -u2 "A Secretary server is already listening at $URL but is not managed by this state directory. Stop it first, then run sex start again."
      return 1
    fi
  fi
  if running_pid >/dev/null; then
    local wanted="normal"
    (( debug )) && wanted="debug"
    local current="normal"
    [[ -f "$MODE_FILE" ]] && current="$(<"$MODE_FILE")"
    if [[ "$current" != "$wanted" ]]; then
      print "Secretary is running in $current mode. Restarting in $wanted mode."
      stop
    else
      open_user
      print "Secretary is already running at $URL"
      (( debug )) && print "Control Room: $URL/control-room"
      return 0
    fi
  fi
  : "${SECRETARY_BOOTSTRAP_TOKEN:?missing bootstrap token}"
  local harness="$(configured_harness)"
  local harness_bin
  if ! harness_bin="$(harness_command 2>/dev/null)"; then
    print -u2 "Configured harness '$harness' is unavailable. Run: sex doctor"
    return 1
  fi
  : > "$LOG_FILE"
  chmod 600 "$LOG_FILE"
  local -a args
  args=("$BIN/secretaryd" -data-dir "$STATE" -listen 127.0.0.1:8081)
  (( debug )) && args+=(--debug)
  local acp_bin="" fx_bin="" opencode_bin="" codex_path=""
  [[ "$harness" == "codex" ]] && acp_bin="$harness_bin"
  [[ "$harness" == "codex" ]] && codex_path="$(path_command codex 2>/dev/null || true)"
  [[ "$harness" == "fx" ]] && fx_bin="$harness_bin"
  [[ "$harness" == "opencode" ]] && opencode_bin="$harness_bin"
  PATH="$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH" \
  CODEX_PATH="$codex_path" \
  NO_BROWSER=1 \
  SECRETARY_ACP_COMMAND="$acp_bin" \
  SECRETARY_FX_COMMAND="$fx_bin" \
  SECRETARY_OPENCODE_COMMAND="$opencode_bin" \
  SECRETARY_CAPABILITY_FILE="$CAPABILITY_FILE" \
  nohup "${args[@]}" >>"$LOG_FILE" 2>&1 &
  print -r -- "$!" > "$PID_FILE"
  chmod 600 "$PID_FILE"
  (( debug )) && print "debug" > "$MODE_FILE" || print "normal" > "$MODE_FILE"
  chmod 600 "$MODE_FILE"
  local code
  for _ in {1..80}; do
    code="$(server_http_code)"
    if [[ "$code" == "200" || "$code" == "401" ]]; then
      if [[ -z "${SECRETARY_CAPABILITY:-}" ]]; then
        local capability=""
        [[ -f "$CAPABILITY_FILE" ]] && capability="$(<"$CAPABILITY_FILE")"
        if [[ -n "$capability" ]]; then
          printf "export SECRETARY_CAPABILITY='%s'\n" "$capability" >> "$ENV_FILE"
          chmod 600 "$ENV_FILE" "$CAPABILITY_FILE"
        fi
      fi
      open_user
      print "Secretary started at $URL"
      (( debug )) && print "Control Room: $URL/control-room"
      return 0
    fi
    sleep 0.25
  done
  print -u2 "Secretary did not become ready. See: $LOG_FILE"
  return 1
}

stop() {
  local pid
  if ! pid="$(running_pid)"; then
    rm -f "$PID_FILE" "$MODE_FILE"
    print "Secretary is not running"
    return 0
  fi
  kill -TERM "$pid"
  for _ in {1..40}; do
    kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE" "$MODE_FILE"; print "Secretary stopped"; return 0; }
    sleep 0.25
  done
  print -u2 "Secretary did not stop. See: $LOG_FILE"
  return 1
}

restart() {
  local -a options
  while (($#)); do
    case "$1" in
      --debug) options+=(--debug) ;;
      *) print -u2 "Unknown restart option: $1"; return 2 ;;
    esac
    shift
  done
  stop
  start "${options[@]}"
}

install_service() {
  local debug=0
  while (($#)); do
    case "$1" in
      --debug) debug=1 ;;
      *) print -u2 "Unknown install-service option: $1"; return 2 ;;
    esac
    shift
  done
  setup
  mkdir -p "${PLIST:h}"
  local debug_arg=""
  (( debug )) && debug_arg='<string>--debug</string>'
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.secretary.sex</string>
  <key>ProgramArguments</key><array><string>$ROOT/sex</string><string>serve</string>$debug_arg</array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
  launchctl bootout "gui/$UID" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$PLIST"
  print "Secretary will start after macOS login."
}

serve() {
  local -a options
  while (($#)); do
    case "$1" in
      --debug) options+=(--debug) ;;
      *) print -u2 "Unknown serve option: $1"; return 2 ;;
    esac
    shift
  done
  write_bootstrap_environment
  load_environment
  local harness="$(configured_harness)"
  local harness_bin
  harness_bin="$(harness_command 2>/dev/null)" || { print -u2 "Configured harness '$harness' is unavailable. Run: sex doctor"; return 1; }
  local -a env_args
  local codex_path=""
  [[ "$harness" == "codex" ]] && codex_path="$(path_command codex 2>/dev/null || true)"
  env_args=(PATH="$BIN:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH" CODEX_PATH="$codex_path" NO_BROWSER=1 SECRETARY_CAPABILITY_FILE="$CAPABILITY_FILE")
  case "$harness" in
    codex) env_args+=(SECRETARY_ACP_COMMAND="$harness_bin") ;;
    fx) env_args+=(SECRETARY_FX_COMMAND="$harness_bin") ;;
    opencode) env_args+=(SECRETARY_OPENCODE_COMMAND="$harness_bin") ;;
  esac
  print -r -- "$$" > "$PID_FILE"
  chmod 600 "$PID_FILE"
  local mode="normal"
  (( ${#options[@]} > 0 )) && mode="debug"
  print -r -- "$mode" > "$MODE_FILE"
  chmod 600 "$MODE_FILE"
  exec env "${env_args[@]}" "$BIN/secretaryd" -data-dir "$STATE" -listen 127.0.0.1:8081 "${options[@]}"
}

case "${1:-}" in
  setup) shift; setup "$@" ;;
  start) shift; start "$@" ;;
  stop) shift; stop "$@" ;;
  restart) shift; restart "$@" ;;
  status)
    if pid="$(running_pid)"; then
      mode="normal"; [[ -f "$MODE_FILE" ]] && mode="$(<"$MODE_FILE")"
      print "running pid=$pid mode=$mode url=$URL"
      if [[ "$mode" == "debug" ]]; then
        print "control-room=$URL/control-room"
      fi
      return 0
    else
      print "stopped"
      return 0
    fi
    ;;
  logs) tail -f "$LOG_FILE" ;;
  doctor) shift; doctor "$@" ;;
  node)
    shift
    case "${1:-}" in
      setup) shift; node_setup "$@" ;;
      start) shift; node_start "$@" ;;
      stop) shift; node_stop "$@" ;;
      status)
        if pid="$(node_running_pid)"; then print "Node running pid=$pid identity=$(node_config_value node) outbound-only"; else print "Node stopped identity=$(node_config_value node 2>/dev/null || print unknown) outbound-only"; fi
        ;;
      logs) shift; tail -f "$NODE_LOG_FILE" ;;
      doctor) shift; node_doctor "$@" ;;
      drain) shift; node_control drain "$@" ;;
      revoke) shift; node_revoke "$@" ;;
      install-service) shift; node_install_service "$@" ;;
      uninstall-service) launchctl bootout "gui/$UID" "$NODE_PLIST" 2>/dev/null || true; rm -f "$NODE_PLIST"; print "Node service removed" ;;
      serve) shift; node_serve "$@" ;;
      *) print -u2 "usage: sex node {setup|start|stop|status|logs|doctor|drain|revoke|install-service|uninstall-service|serve}"; return 2 ;;
    esac
    ;;
  install-service) shift; install_service "$@" ;;
  uninstall-service) launchctl bootout "gui/$UID" "$PLIST" 2>/dev/null || true; rm -f "$PLIST"; print "Service removed" ;;
  serve) shift; serve "$@" ;;
  *) usage ;;
esac
