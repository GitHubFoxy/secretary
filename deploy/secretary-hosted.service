[Unit]
Description=Secretary (hosted, only OpenCode)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/secretary/server
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SECRETARY_HARNESSES=opencode
Environment=SECRETARY_OPENCODE_MODELS=pag/muse-spark-1.3-contributor
ExecStart=%h/.bun/bin/bun index.ts
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
