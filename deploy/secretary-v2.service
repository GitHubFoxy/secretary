[Unit]
Description=Secretary v2
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/secretary-v2/server
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun index.ts
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
