#!/usr/bin/env bash
set -euo pipefail

case "${1:-help}" in
  help|--help|-h)
    printf '%s\n' 'Использование: secretary {pair|status|start|stop|help}' '  pair    Создать код сопряжения' '  status  Показать состояние службы' '  start   Запустить службу' '  stop    Остановить службу' '  help    Показать эту справку'
    ;;
  pair)
    root=$(dirname "$(realpath "$0")")
    if [ -x "$HOME/.secretary/bun/bin/bun" ]; then
      exec "$HOME/.secretary/bun/bin/bun" "$root/server/auth.ts"
    fi
    exec bun "$root/server/auth.ts"
    ;;
  status)
    exec systemctl --user status --no-pager secretary.service
    ;;
  start|stop)
    exec systemctl --user "$1" secretary.service
    ;;
  *)
    printf 'Неизвестная команда: %s\nИспользуйте secretary help.\n' "$1" >&2
    exit 1
    ;;
esac
